# Offline by default. Set a provider and key to use a real model.
DEMO_PROVIDER=fake

MCP_URL=http://127.0.0.1:3001/mcp
MCP_NAME=demo
MCP_TOKEN=

# Comma-separated host-approved domains an app may name in its CSP metadata.
MCP_APP_ALLOWED_DOMAINS=

HOST_ORIGIN=http://127.0.0.1:8080
VIEW_ORIGIN=http://127.0.0.1:8081

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
